  "_padroes_copy": "Expressões regulares (sem acento, minúsculas) que reconhecem a ESTRUTURA da copy de low ticket. Cada uma soma o peso indicado. Adicione novos com a opção 'ensinar com um anúncio'.",
  "padroes_copy": [
    {
      "nome": "gancho de dor em pergunta",
      "peso": 2,
      "regex": "^\\W*(cansad[oa]|chega de|voce (tambem|ainda|sabia|quer|precisa|vive|sofre|ja)|ja pensou|quer (aprender|saber|parar|ter|comecar|economizar)|sente que|perdendo tempo|nao aguenta|esta (cansad|perdid|sem)|tem dificuldade|sonha em|imagine)[^?]{0,160}\\?"
    },
    {
      "nome": "quantidade + conteúdo (+100 mapas, mais de 300 receitas)",
      "peso": 2,
      "regex": "(\\+\\s?\\d{2,5}|mais de \\d{2,5}|\\d{2,5}\\s?\\+)\\s?(mil\\s)?[a-z]{3,}"
    },
    {
      "nome": "'ideal para' / 'perfeito para' / 'para quem'",
      "peso": 2,
      "regex": "(ideal|perfeito|indicado|feito|criado) (para|pra)\\s?:|para quem (quer|deseja|precisa|esta|ama|trabalha)|ideal (para|pra)"
    },
    {
      "nome": "lista com emoji (📌 ✅ ✔️ 👉 🔹)",
      "peso": 2,
      "regex": "(📌|✅|✔️|✔|👉|🔹|🔸|▪️|☑️|💡|⭐|➡️)[^\\n]{3,60}(\\n|$)"
    },
    {
      "nome": "promessa de organização / praticidade",
      "peso": 1,
      "regex": "(tudo organizad|em um so lugar|de forma (muito )?(mais )?(visual|pratica|simples|rapida|facil|organizada)|direto ao ponto|passo a passo|sem enrolacao|facil de (usar|aplicar|entender)|pronto para (usar|imprimir|aplicar|postar))"
    },
    {
      "nome": "CTA de conhecer o material",
      "peso": 2,
      "regex": "(clique (no|em|abaixo|aqui)|toque (no|em) saiba mais|saiba mais|veja por dentro|conhecer o material|conheca o material|quero (o meu|garantir|conhecer|acessar)|garanta (ja )?o seu|acesse (agora|ja)|link (abaixo|na bio))"
    },
    {
      "nome": "preço âncora ('hoje por', 'de 97 por')",
      "peso": 2,
      "regex": "(hoje por|so hoje|apenas hoje|de r?\\$?\\s?\\d{2,3}[,.]?\\d{0,2} por|por (apenas|somente|so) r?\\$?\\s?\\d)"
    },
    {
      "nome": "público estudante / profissional",
      "peso": 1,
      "regex": "(faculdade|estudantes?|concurso|provas?|residencia|enem|professor(a|es)?|nutricionist|enfermagem|fisioterap|psicolog|pedagog|mae(s)? de|maes|artesa|confeiteir|manicure|designer|social media)"
    },
    {
      "nome": "entrega digital",
      "peso": 2,
      "regex": "(acesso (imediato|vitalicio|na hora)|receba (no|pelo) (e-?mail|whatsapp)|baixe|download|arquivo(s)? (digital|em pdf)|formato (pdf|digital)|material digital|imprima (quantas|em casa))"
    }
  ],
